# Paraşüt MCP Server Configuration

# Required (or auto-discovered via /me when using OAuth)
PARASUT_COMPANY_ID=your_company_id

# OAuth Credentials
PARASUT_CLIENT_ID=your_client_id
PARASUT_CLIENT_SECRET=your_client_secret

# Option 1: Direct Tokens (Bearer / Refresh)
PARASUT_ACCESS_TOKEN=your_access_token
PARASUT_REFRESH_TOKEN=your_refresh_token

# Option 2: Password Grant (Legacy)
PARASUT_USERNAME=your_username_or_email
PARASUT_PASSWORD=your_password

# Optional
PARASUT_BASE_URL=https://api.parasut.com/v4
DEBUG=false
HTTPS_PROXY=

# Streamable HTTP / Remote MCP Configuration
MCP_TRANSPORT=stdio # "stdio" or "http"
PORT=3000
HOST=0.0.0.0
MCP_PUBLIC_URL=https://parasut-mcp.example.com
MCP_OAUTH_ENABLED=true
MCP_API_KEY=your_optional_static_bearer_or_m2m_key
